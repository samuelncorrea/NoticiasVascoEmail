      "name": "Limitar a 5 notícias",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        460,
        250
      ]
    },
    {
      "parameters": {
        "jsCode": "// Junta as notícias em um único e-mail HTML\nconst itens = $input.all();\n\nconst lista = itens\n  .map((item) => {\n    const n = item.json;\n    const titulo = n.title || 'Sem título';\n    const link = n.link || '#';\n    return `<li><a href=\"${link}\"><strong>${titulo}</strong></a></li>`;\n  })\n  .join('');\n\nconst data = new Date().toLocaleDateString('pt-BR');\n\nreturn [\n  {\n    json: {\n      assunto: `Notícias do Vasco - ${data}`,\n      html: `<h2>⚽ Notícias do Vasco da Gama - ${data}</h2><ol>${lista}</ol>`,\n    },\n  },\n];"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Montar e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        250
      ]
    },
    {
      "parameters": {
        "fromEmail": "SEU_EMAIL@exemplo.com",
        "toEmail": "SEU_EMAIL@exemplo.com",
        "subject": "={{ $json.assunto }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        900,
        250
      ]
    }
  ],
